---
# Broad groups, and out of them what contradicts the Google style or cannot
# be had on the AVR. Each exception says why.
Checks: >
  bugprone-*,
  clang-analyzer-*,
  google-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-dynamic-static-initializers,
  -google-explicit-constructor,
  -misc-explicit-constructor,
  -modernize-deprecated-headers,
  -modernize-return-braced-init-list,
  -modernize-use-trailing-return-type,
  -readability-identifier-length,
  -readability-named-parameter
# bugprone-dynamic-static-initializers: it reports the extern declaration of
#   every group, as it cannot see the constexpr definition in the .cpp. A
#   group has to be extern, its address being what identifies it, so only a
#   NOLINT in every group, a sketch's own as well, would silence it.
# google-explicit-constructor, misc-explicit-constructor: cpplint checks the
#   same rule as runtime/explicit, and the implicit constructors that are
#   meant carry their NOLINT there; two tools would want two per line.
# modernize-deprecated-headers: avr-gcc comes without a C++ standard library,
#   so there is no <cstdint>, only <stdint.h>.
# modernize-return-braced-init-list: `return Error();` says that no error is
#   returned, `return {};` hides it.
# modernize-use-trailing-return-type: Google puts the return type in front.
# readability-identifier-length: Google allows `f` or `a` and `b` where the
#   scope is a few lines.
# readability-named-parameter: Google leaves out the name of a parameter that
#   is unused where the context explains it, as the enum that only picks the
#   overload of GetErrorGroup().
WarningsAsErrors: '*'
# (^|/), as tools/tidy.sh names the files relative to the repository, and a
# header beside an example is found as examples/.../font_error.h.
HeaderFilterRegex: '(^|/)(src|examples)/'
CheckOptions:
  # A text in PROGMEM is a char array: F() and the tables of the groups need
  # one. Any other array is a utl::array.
  modernize-avoid-c-arrays.AllowStringArrays: true
  # A struct with only public members is what Google calls a struct, and
  # utl::array has to be one to stay an aggregate.
  misc-non-private-member-variables-in-classes.IgnoreClassesWithAllMemberVariablesBeingPublic: true
  # Google's "include what you use", with Arduino.h as what provides the
  # core: F(), __FlashStringHelper and the rest come through it.
  misc-include-cleaner.IgnoreHeaders: '.*/cores/arduino/.*'
