{
    "id": "shared",
    "version": "1.0.0",
    "name": "Utl shared editor configuration",
    "description": "Extensions, the Arduino AVR core, the GCC plugin, the CMake build of the tests and the volumes for the Arduino data directory, uv's cache and logins shared by every devcontainer.json variant.",
    "customizations": {
        "vscode": {
            "extensions": [
                "llvm-vs-code-extensions.vscode-clangd",
                "ms-vscode.cpptools",
                "eamodio.gitlens",
                "openai.chatgpt"
            ],
            // clangd for IntelliSense, with the databases .clangd names; cpptools only
            // for debugging, its IntelliSense off so that the two do not answer twice.
            // No header insertion: a sketch includes <Utl.h> first, and an include
            // put in by the editor would not know that. An .ino is C++.
            "settings": {
                "C_Cpp.intelliSenseEngine": "disabled",
                "clangd.path": "/usr/local/bin/clangd",
                "clangd.arguments": ["--header-insertion=never"],
                "files.associations": { "*.ino": "cpp" }
            }
        }
    },
    "containerEnv": {
        "GH_HOST": "github.com"
    },
    // arduino:avr at 1.8.8, as CI pins it: the plugin loads only into the cc1plus it was
    // built for, and the sizes in the README were measured with it.
    "postCreateCommand": "arduino-cli core update-index && arduino-cli core install arduino:avr@1.8.8 && tools/build_plugin.sh && cmake --preset default && tools/tidy.sh --database-only && arduino-cli version && arduino-lint --version && gh --version && uv --version && clangd --version && command -v simavr",
    "mounts": [
        {
            "source": "utl-arduino15",
            "target": "/home/vscode/.arduino15",
            "type": "volume"
        },
        {
            "source": "utl-uv-cache",
            "target": "/home/vscode/.cache/uv",
            "type": "volume"
        },
        {
            "source": "utl-codex",
            "target": "/home/vscode/.codex",
            "type": "volume"
        },
        {
            "source": "utl-gh",
            "target": "/home/vscode/.config/gh",
            "type": "volume"
        }
    ]
}
